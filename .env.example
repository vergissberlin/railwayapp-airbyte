# Core Airbyte settings
AIRBYTE_ROLE=server

# Airbyte internal API and logging
AIRBYTE_URL=http://127.0.0.1:8001
LOG_LEVEL=INFO

# Database connection — use a Railway reference variable pointing at your
# Postgres service. Replace "Postgres" with the actual service name in your project.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Required in most setups — use a Railway reference variable pointing at your
# Temporal service. Replace "Temporal" with the actual service name in your project.
TEMPORAL_HOST=${{Temporal.RAILWAY_PRIVATE_DOMAIN}}
